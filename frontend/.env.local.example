# ====================================================
# Vision Spark Frontend — Environment Variables Example
# ====================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ====================================================
# AI CHATBOT API KEYS (optional — app works without them)
# ====================================================

# OpenRouter API Key (FREE tier available - supports Gemini, LLaMA, and more)
# Get a FREE key at: https://openrouter.ai → Sign Up → Copy API Key → Paste below
# Example: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=

# Google Gemini API Key (FREE - 1500 requests/day, fastest option)
# Get a FREE key at: https://aistudio.google.com/app/apikey
# Example: AIzaSyXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=
